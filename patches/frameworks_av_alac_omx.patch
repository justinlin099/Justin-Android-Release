+status_t ACodec::setupAlacCodec(bool encoder, int32_t numChannels, int32_t sampleRate, AudioEncoding encoding) {
+    if (encoder) {
+        ALOGW("ALAC encoding is not supported.");
+        return INVALID_OPERATION;
+    }
+
+    // Default target encoding
+    AudioEncoding targetEncoding = encoding;
+
+    QOMX_AUDIO_PARAM_ALACTYPE def;
+    InitOMXParams(&def);
+    def.nPortIndex = kPortIndexInput;
+    def.bBytesStreamMode = OMX_FALSE;
+
+    sp<ABuffer> csd0;
+    if (mConfigFormat->findBuffer("csd-0", &csd0) && csd0->size() >= 24) {
+        uint8_t *data = csd0->data();
+        
+        // Manual Big-Endian to Host-Endian parsing
+        uint32_t frameLength = (uint32_t)data[0] << 24 | (uint32_t)data[1] << 16 | (uint32_t)data[2] << 8 | (uint32_t)data[3];
+        uint16_t maxRun = (uint16_t)data[10] << 8 | (uint16_t)data[11];
+        uint32_t maxFrameBytes = (uint32_t)data[12] << 24 | (uint32_t)data[13] << 16 | (uint32_t)data[14] << 8 | (uint32_t)data[15];
+        uint32_t avgBitRate = (uint32_t)data[16] << 24 | (uint32_t)data[17] << 16 | (uint32_t)data[18] << 8 | (uint32_t)data[19];
+        uint32_t sampleRateVal = (uint32_t)data[20] << 24 | (uint32_t)data[21] << 16 | (uint32_t)data[22] << 8 | (uint32_t)data[23];
+
+        // DECISION: Only use 32-bit path if the file is actually 24-bit.
+        // This prevents the 2x speed issue on 16-bit songs.
+        if (data[5] == 24) {
+            targetEncoding = kAudioEncodingPcm32bit;
+            ALOGI("ALAC_DIAG: 24-bit file detected. Using 32-bit output path.");
+        } else {
+            targetEncoding = kAudioEncodingPcm16bit;
+            ALOGI("ALAC_DIAG: 16-bit file detected. Using 16-bit output path.");
+        }
+
+        // Rewrite multi-byte fields as LITTLE ENDIAN to satisfy the buggy decoder
+        data[0] = frameLength & 0xFF;
+        data[1] = (frameLength >> 8) & 0xFF;
+        data[2] = (frameLength >> 16) & 0xFF;
+        data[3] = (frameLength >> 24) & 0xFF;
+        data[10] = maxRun & 0xFF;
+        data[11] = (maxRun >> 8) & 0xFF;
+        data[12] = maxFrameBytes & 0xFF;
+        data[13] = (maxFrameBytes >> 8) & 0xFF;
+        data[14] = (maxFrameBytes >> 16) & 0xFF;
+        data[15] = (maxFrameBytes >> 24) & 0xFF;
+        data[16] = avgBitRate & 0xFF;
+        data[17] = (avgBitRate >> 8) & 0xFF;
+        data[18] = (avgBitRate >> 16) & 0xFF;
+        data[19] = (avgBitRate >> 24) & 0xFF;
+        data[20] = sampleRateVal & 0xFF;
+        data[21] = (sampleRateVal >> 8) & 0xFF;
+        data[22] = (sampleRateVal >> 16) & 0xFF;
+        data[23] = (sampleRateVal >> 24) & 0xFF;
+
+        def.nFrameLength = frameLength;
+        def.nCompatibleVersion = data[4];
+        def.nBitDepth = data[5];
+        def.nPb = data[6];
+        def.nMb = data[7];
+        def.nKb = data[8];
+        def.nChannels = data[9];
+        def.nMaxRun = maxRun;
+        def.nMaxFrameBytes = maxFrameBytes;
+        def.nAvgBitRate = avgBitRate;
+        def.nSampleRate = sampleRateVal;
+    } else {
+        def.nChannels = (OMX_U8)numChannels;
+        def.nSampleRate = (OMX_U32)sampleRate;
+        def.nBitDepth = 16;
+        def.nFrameLength = 4096;
+        targetEncoding = kAudioEncodingPcm16bit;
+    }
+
+    status_t err = setupRawAudioFormat(kPortIndexOutput, sampleRate, numChannels, targetEncoding);
+    if (err != OK) {
+        return err;
+    }
+
+    def.nChannelLayoutTag = 0;
+    err = mOMXNode->setParameter(QOMX_IndexParamAudioAlac, &def, sizeof(def));
+    if (err != OK) {
+        ALOGE("setupAlacCodec(): Error %d setting QOMX_IndexParamAudioAlac parameter", err);
+        return err;
+    }
+
+    return selectAudioPortFormat(kPortIndexInput, OMX_AUDIO_CodingALAC);
+}
